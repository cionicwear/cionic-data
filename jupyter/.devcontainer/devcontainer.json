{
  "name": "Jupyter + Cionic",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "jupyter",
  "workspaceFolder": "/home/jovyan/work",
  "remoteUser": "jovyan",
  "overrideCommand": false,

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "jupyter.widgetScriptSources": ["jsdelivr", "unpkg", "cdnjs", "npm"]
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers"
      ]
    }
  },

  "postCreateCommand": "echo 'VS Code container ready.'"
}
